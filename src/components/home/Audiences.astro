---
import Heading from './Heading.astro';

// Columnas con divisores de la referencia ("Hecho para negocios gastronómicos reales.")
const audiences = [
  { title: 'IPS', href: '/software-para-ips/', text: 'Agenda multiespecialidad, confirmaciones y reportes para la operación diaria.' },
  { title: 'Clínicas y hospitales', text: 'Alto volumen de citas sin saturar la línea de recepción.' },
  { title: 'Centros de diagnóstico', text: 'Citas de exámenes con recordatorios automáticos.' },
  { title: 'Call centers de salud', text: 'Agentes y asistente de WhatsApp sobre la misma agenda.' },
];
---

<section class="section-padding border-t border-line" aria-labelledby="audiences-title">
  <div class="container-custom">
    <Heading
      id="audiences-title"
      eyebrow="Una agenda para cada forma de atender"
      title="Hecho para instituciones"
      tone="de salud reales."
      aside="Configura especialidades, profesionales y horarios según la manera en que trabaja tu equipo."
    />
    <ul class="grid border-y border-line sm:grid-cols-2 lg:grid-cols-4">
      {audiences.map((a, i) => (
        <li data-animate data-delay={String(i + 1)} class:list={['border-line', i > 0 && 'max-sm:border-t', i % 2 === 1 && 'sm:border-l', i >= 2 && 'sm:max-lg:border-t', i === 2 && 'lg:border-l']}>
          <a href={a.href ?? '/contacto/'} class="group flex h-full min-h-48 flex-col p-6 lg:px-6 lg:py-8">
            <h3 class="text-xl font-semibold tracking-[-0.035em] text-ink">{a.title}</h3>
            <p class="mt-3 max-w-[16rem] text-[13px] leading-relaxed text-muted">{a.text}</p>
            <svg class="mt-auto ml-auto h-4 w-4 text-accent transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
