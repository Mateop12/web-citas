---
import Button from '../ui/Button.astro';

const agenda = [
  { t: '08:00', n: 'María González', e: 'Cardiología', ok: true },
  { t: '09:30', n: 'Carlos Ruiz', e: 'Medicina general', ok: true },
  { t: '11:00', n: 'Ana Torres', e: 'Pediatría', ok: false },
];

// Integraciones mencionadas en el FAQ; como texto, sin logos de terceros
const integrations = ['WhatsApp Business', 'Google Calendar', 'Outlook', 'Tu HIS vía API REST'];
---

<section class="hero relative overflow-hidden px-4 pt-[78px] sm:px-6 lg:px-8 lg:pt-[90px]" aria-labelledby="hero-title">
  <div class="container-custom">
    <div class="grid items-center gap-12 py-14 lg:grid-cols-[44%_56%] lg:gap-0 lg:py-16">
      <div class="relative z-10 text-center lg:text-left">
        <p class="eyebrow hero-enter inline-flex items-center gap-3">
          <span class="h-1.5 w-1.5 rounded-full bg-accent" aria-hidden="true"></span>
          Menos llamadas. Más citas.
        </p>

        <h1 id="hero-title" class="display-xl hero-lift hero-enter-d1 mt-6 text-ink">
          Software de agendamiento clínico con IA
        </h1>

        <p class="hero-lift hero-enter-d2 mt-6 text-lg leading-snug tracking-[-0.02em] text-ink sm:text-[21px]">
          Llena tu agenda sin saturar el teléfono: tus pacientes agendan, confirman y reprograman solos por WhatsApp y web, las 24 horas.
        </p>
        <p class="hero-enter hero-enter-d2 mx-auto mt-4 max-w-xl text-sm leading-relaxed text-muted lg:mx-0">
          Gestiona citas, confirmaciones, recordatorios, lista de espera y reportes desde una plataforma
          pensada para IPS, clínicas y centros de diagnóstico en Colombia.
        </p>

        <a href="/solucion/" class="hero-enter hero-enter-d3 mt-5 inline-flex items-center gap-2 text-[13px] font-medium text-accent hover:underline">
          <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0-4-4m4 4-4 4m0 6H4m0 0 4 4m-4-4 4-4" />
          </svg>
          Integración con tu historia clínica (HIS)
        </a>

        <div class="hero-enter hero-enter-d3 mt-8 flex flex-col gap-3 sm:flex-row sm:justify-center lg:justify-start">
          <Button openDemoModal variant="primary" size="md">Solicitar demo</Button>
          <Button href="/solucion/" variant="outline" size="md">
            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linejoin="round" d="M7 5v14l11-7L7 5Z" />
            </svg>
            Ver cómo funciona
          </Button>
        </div>

        <ul class="hero-enter hero-enter-d4 mt-7 flex flex-wrap justify-center gap-x-6 gap-y-2 text-xs text-muted lg:justify-start">
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3 4.5 6v5.5c0 4.6 3.2 8.4 7.5 9.5 4.3-1.1 7.5-4.9 7.5-9.5V6L12 3Z" /><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4" />
            </svg>
            Implementación en 24 a 48 horas
          </li>
          <li class="flex items-center gap-2">
            <svg class="h-4 w-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 10h8M8 14h5m-9 6 2.5-3H18a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v14Z" />
            </svg>
            Soporte en español
          </li>
        </ul>
      </div>

      <!-- Visual: la agenda del día, inclinada como la captura de la referencia -->
      <!-- Wrapper para la entrada: la animación pisaría el transform inline del parallax de #hero-visual -->
      <div class="hero-enter hero-enter-d2">
      <div id="hero-visual" class="hero-visual scroll-sink relative mx-auto w-full max-w-xl lg:-mr-8 lg:max-w-none lg:pl-14" aria-hidden="true">
        <p class="float-y absolute -top-4 right-4 z-20 flex items-center gap-2 rounded-lg border border-line bg-card px-3 py-2 text-xs font-medium text-ink shadow-[var(--shadow)] sm:right-10">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          Agenda conectada. Pacientes confirmados.
        </p>

        <div class="relative rotate-[-2deg] overflow-hidden rounded-2xl border border-line bg-card shadow-[var(--shadow)]">
          <div class="flex items-center justify-between border-b border-line px-5 py-3">
            <div class="flex gap-1.5">
              <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-line"></span>
            </div>
          </div>

          <div class="grid grid-cols-[9rem_1fr] max-sm:grid-cols-1">
            <div class="border-r border-line p-4 max-sm:hidden">
              <p class="mb-3 text-[10px] font-semibold tracking-[0.18em] text-muted uppercase">Hoy</p>
              {['Agenda', 'Pacientes', 'Lista de espera', 'Campañas', 'Reportes'].map((item, i) => (
                <p class:list={['mb-1 rounded-md px-2 py-1.5 text-[11px]', i === 0 ? 'bg-accent/15 font-semibold text-accent' : 'text-muted']}>{item}</p>
              ))}
            </div>

            <div class="p-5">
              <div class="mb-4 flex items-end justify-between">
                <div>
                  <p class="text-[11px] text-muted">Agenda de hoy · ejemplo ilustrativo</p>
                  <p class="text-lg font-semibold tracking-[-0.03em] text-ink">Martes, 26 jun</p>
                </div>
                <span class="rounded-full bg-accent/15 px-3 py-1 text-xs font-semibold text-accent">32 citas</span>
              </div>
              <div class="mb-4 grid grid-cols-3 gap-2">
                {[['18', 'Confirmadas'], ['9', 'Pendientes'], ['5', 'Nuevas']].map(([n, l]) => (
                  <div class="rounded-xl border border-line bg-surface px-3 py-2.5">
                    <p class="font-mono-data text-xl font-semibold text-ink" data-counter={n}>{n}</p>
                    <p class="text-[10px] text-muted">{l}</p>
                  </div>
                ))}
              </div>
              <div class="space-y-2">
                {agenda.map((a, i) => (
                  <div class="hero-enter flex items-center gap-3 rounded-xl border border-line px-3 py-2.5" style={`animation-delay:${0.7 + i * 0.15}s`}>
                    <span class="font-mono-data text-xs font-semibold text-accent">{a.t}</span>
                    <div class="min-w-0 flex-1">
                      <p class="truncate text-[13px] font-medium text-ink">{a.n}</p>
                      <p class="truncate text-[11px] text-muted">{a.e}</p>
                    </div>
                    {a.ok ? (
                      <span class="rounded-full bg-accent/15 px-2 py-0.5 text-[10px] font-semibold text-accent">Confirmada</span>
                    ) : (
                      <span class="status-swap text-[10px] font-semibold">
                        <span class="rounded-full bg-amber-400/15 px-2 py-0.5 text-amber-500">Pendiente</span>
                        <span class="rounded-full bg-accent/15 px-2 py-0.5 text-accent">Confirmada</span>
                      </span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="float-y float-y-late absolute -bottom-12 left-0 z-20 flex w-64 items-start gap-3 rounded-xl border border-line bg-card p-4 shadow-[var(--shadow)] sm:left-4 lg:-left-6">
          <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-[#25D366]/15 text-[#25D366]">
            <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" /></svg>
          </span>
          <div>
            <p class="text-[13px] font-semibold text-ink">Del WhatsApp a la agenda</p>
            <p class="mt-0.5 text-[11px] leading-snug text-muted">Sin llamadas. Sin doble digitación.</p>
          </div>
        </div>
      </div>
      </div>
    </div>

    <div class="hero-enter hero-enter-d4 flex flex-col gap-5 border-t border-line py-8 sm:flex-row sm:items-center">
      <p class="shrink-0 text-[11px] font-semibold tracking-[0.18em] text-muted uppercase">Se integra con</p>
      <ul class="flex flex-wrap gap-3">
        {integrations.map((name) => (
          <li class="rounded-xl border border-line bg-card px-5 py-3 text-sm font-semibold tracking-[-0.02em] text-ink">{name}</li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(60% 55% at 76% 40%, color-mix(in oklab, var(--accent) 9%, transparent), transparent 70%);
  }
</style>
