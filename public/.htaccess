# Hostinger (LiteSpeed/Apache). Astro copia este archivo a dist/.
# Antes de subir: comparar con el .htaccess que ya exista en public_html y fusionar.

RewriteEngine On

# www -> dominio canónico. HTTP->HTTPS ya lo hace el CDN (hcdn); una regla
# "%{HTTPS} off" aquí puede causar bucle si el CDN llega al origen por HTTP.
RewriteCond %{HTTP_HOST} ^www\.gena\.monkeymindtech\.com$ [NC]
RewriteRule ^(.*)$ https://gena.monkeymindtech.com/$1 [R=301,L]

<IfModule mod_headers.c>
  # Sin includeSubDomains: app.gena.monkeymindtech.com aún no sirve HTTPS.
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Solo los archivos de /_astro/ llevan hash (nombre.Ab12Cd34.ext): inmutables.
  # logo.png / og-image.png tienen nombre fijo y no entran en esta regla.
  <FilesMatch "\.[0-9A-Za-z_-]{8}\.(css|js|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, s-maxage=3600"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
