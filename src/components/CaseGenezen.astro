---
import Heading from './home/Heading.astro';
import Button from './ui/Button.astro';

// Caso de éxito real. Datos entregados por el dueño (oct. 2026): 5 meses de uso, más de 60.000 citas agendadas.
// Actualizar las cifras aquí cuando cambien; no agregar métricas sin respaldo.
const stats = [
  { prefix: '+', n: 60000, suffix: '', label: 'citas agendadas con GEN.AI' },
  { prefix: '', n: 5, suffix: ' meses', label: 'en operación' },
  { prefix: '+', n: 12000, suffix: '', label: 'citas al mes en promedio' },
];

const results = [
  {
    title: 'Para los pacientes',
    text: 'Una mejor experiencia al solicitar su cita: la reservan en línea desde el portal de la clínica, sin depender de una llamada ni del horario de recepción.',
  },
  {
    title: 'Para el personal operativo',
    text: 'Agendar es mucho más fácil y rápido. El equipo dejó de registrar cada cita a mano en el sistema y se concentra en atender a los pacientes.',
  },
];
---

<section class="section-padding border-t border-line" aria-labelledby="case-genezen-title">
  <div class="container-custom">
    <Heading
      id="case-genezen-title"
      eyebrow="Caso de éxito"
      title="Clínica Genezen:"
      tone="más de 60.000 citas con GEN.AI."
      aside="Una clínica colombiana que pasó del agendamiento manual al autoagendamiento con GEN.AI."
    />

    <dl class="grid border-y border-line sm:grid-cols-3">
      {stats.map((s, i) => (
        <div data-animate data-delay={String(i + 1)} class:list={['flex flex-col p-6 lg:py-8', i > 0 && 'border-line max-sm:border-t sm:border-l']}>
          <dt class="text-[13px] text-muted">{s.label}</dt>
          <dd class="font-mono-data order-first text-3xl font-semibold tracking-[-0.03em] text-ink sm:text-4xl" data-counter={s.n} data-prefix={s.prefix} data-suffix={s.suffix}>{s.prefix}{s.n.toLocaleString('es-CO')}{s.suffix}</dd>
        </div>
      ))}
    </dl>

    <div class="mt-10 grid gap-10 lg:grid-cols-[1.2fr_1fr] lg:gap-16">
      <figure data-animate>
        <blockquote>
          <p class="font-display text-2xl leading-snug font-semibold tracking-[-0.03em] text-ink sm:text-3xl">
            «Pasamos de agendar manualmente en el sistema a autoagendar con GEN.AI».
          </p>
        </blockquote>
        <figcaption class="mt-4 text-sm text-muted">Clínica Genezen</figcaption>
        <div class="mt-8 flex flex-wrap items-center gap-4">
          <Button openDemoModal variant="primary" size="md">Solicitar demo</Button>
          <a
            href="https://citas.clinicagenezen.net/"
            class="inline-flex min-h-11 items-center gap-2 text-[13px] font-semibold text-accent hover:underline"
            target="_blank"
            rel="noopener"
          >
            Ver su portal de citas
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17 17 7M8 7h9v9" /></svg>
          </a>
        </div>
      </figure>

      <ul class="space-y-6">
        {results.map((r, i) => (
          <li data-animate data-delay={String(i + 1)} class="rounded-xl border border-line bg-card p-6">
            <h3 class="text-lg font-semibold tracking-[-0.025em] text-ink">{r.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-muted">{r.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
