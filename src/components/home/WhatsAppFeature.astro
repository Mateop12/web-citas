---
// Sección dividida de la referencia ("Menús digitales QR"): texto + pasos numerados a la izquierda, demo a la derecha.
const steps = [
  { title: 'Escribe', text: 'El paciente pide su cita como le escribiría a una persona.' },
  { title: 'Elige', text: 'La IA muestra horarios reales y el paciente escoge.' },
  { title: 'Confirma', text: 'La cita queda en tu agenda y llega el recordatorio.' },
];

const chat = [
  { me: true, text: 'Hola, quiero agendar cardiología' },
  { me: false, text: 'Con gusto. ¿Para qué fecha te gustaría la cita?' },
  { me: true, text: 'El próximo martes por la mañana' },
  { me: false, text: 'Disponible:\nMar 2 jul · 9:00, Dr. Mendoza\nMar 2 jul · 10:30, Dra. Vargas' },
  { me: true, text: '9:00 con el Dr. Mendoza' },
  { me: false, text: 'Cita confirmada. Te enviaremos un recordatorio 24 horas antes.' },
];
---

<section class="section-padding border-t border-line bg-surface/60" aria-labelledby="wa-title">
  <div class="container-custom grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div data-animate>
      <p class="eyebrow mb-4">El canal que tus pacientes ya usan</p>
      <h2 id="wa-title" class="display-lg text-ink">
        Agendamiento por WhatsApp. <span class="tone">Con IA, las 24 horas.</span>
      </h2>
      <p class="mt-6 max-w-lg text-base leading-relaxed text-muted">
        Usamos la API oficial de WhatsApp Business. El asistente entiende lenguaje natural y guía la
        conversación para agendar, cancelar o reprogramar, sin que nadie de recepción tenga que contestar.
      </p>

      <ol class="mt-8 max-w-lg border-t border-line">
        {steps.map((s, i) => (
          <li data-animate data-delay={String(i + 1)} class="grid grid-cols-[3rem_7rem_1fr] items-baseline gap-2 border-b border-line py-4 max-sm:grid-cols-[2.5rem_1fr]">
            <span class="font-mono-data text-xs font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
            <span class="text-[15px] font-semibold tracking-[-0.02em] text-ink">{s.title}</span>
            <span class="text-[13px] text-muted max-sm:col-start-2">{s.text}</span>
          </li>
        ))}
      </ol>
      <a href="/bot-whatsapp-citas/" class="mt-8 inline-flex items-center gap-2 text-[13px] font-semibold text-accent hover:underline">
        Conoce el bot de WhatsApp para agendar citas
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
    </div>

    <div class="mx-auto w-full max-w-md overflow-hidden rounded-2xl border border-line shadow-[var(--shadow)]" aria-hidden="true" data-animate="scale">
      <div class="flex items-center gap-3 bg-[#075e54] px-4 py-3.5">
        <img src="/logo-96.png" alt="" width="36" height="36" class="h-9 w-9 rounded-full" loading="lazy" />
        <div>
          <p class="text-sm font-semibold text-white">GEN.AI Asistente</p>
          <p class="text-xs text-white/70">En línea</p>
        </div>
      </div>
      <div class="space-y-2.5 bg-[#efe7de] p-4">
        {chat.map((m, i) => (
          <div style={`--d:${0.4 + i * 0.45}s`} class:list={['mv-pop flex', m.me ? 'justify-end' : 'justify-start']}>
            <p class:list={['max-w-[85%] rounded-2xl px-3.5 py-2 text-[13px] leading-relaxed whitespace-pre-line text-[#111b21]', m.me ? 'rounded-tr-sm bg-[#d9fdd3]' : 'rounded-tl-sm bg-white shadow-sm']}>{m.text}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
