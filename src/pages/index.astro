---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Modules from '../components/home/Modules.astro';
import WhatsAppFeature from '../components/home/WhatsAppFeature.astro';
import InteropPanel from '../components/home/InteropPanel.astro';
import PanelShowcase from '../components/home/PanelShowcase.astro';
import CaseGenezen from '../components/CaseGenezen.astro';
import Audiences from '../components/home/Audiences.astro';
import HomeFAQ from '../components/home/HomeFAQ.astro';
import FinalCTA from '../components/home/FinalCTA.astro';
import { homeFaqs } from '../data/faqs';
---

<BaseLayout faqItems={homeFaqs}>
  <Navbar />
  <main id="main-content">
    <HomeHero />
    <Modules />
    <WhatsAppFeature />
    <InteropPanel />
    <PanelShowcase />
    <CaseGenezen />
    <Audiences />
    <HomeFAQ />
    <FinalCTA />
  </main>
  <Footer />
</BaseLayout>
