---
import BrandLogo from './ui/BrandLogo.astro';
import { LEGAL_NAV } from '../data/legal';
import { PRODUCT_PAGES } from '../data/pages-seo';
import { SITE } from '../data/seo';

const currentYear = new Date().getFullYear();

const footerLinks = {
  Soluciones: [
    { label: 'Software para IPS', href: PRODUCT_PAGES.softwareIps.slug },
    { label: 'Agendamiento web', href: PRODUCT_PAGES.agendamientoWeb.slug },
    { label: 'Bot de WhatsApp', href: PRODUCT_PAGES.botWhatsapp.slug },
    { label: 'Recordatorios de citas', href: PRODUCT_PAGES.recordatorios.slug },
  ],
  Producto: [
    { label: 'Producto', href: PRODUCT_PAGES.whatsapp.slug },
    { label: 'Solución', href: PRODUCT_PAGES.solucion.slug },
    { label: 'Panel administrativo', href: PRODUCT_PAGES.panel.slug },
    { label: 'Problema', href: PRODUCT_PAGES.problema.slug },
  ],
  Empresa: [
    { label: 'Nosotros', href: PRODUCT_PAGES.nuestrosPlus.slug },
    { label: 'Preguntas frecuentes', href: PRODUCT_PAGES.faq.slug },
    { label: 'Solicitar demo', href: PRODUCT_PAGES.contacto.slug },
  ],
  Legal: LEGAL_NAV.map(({ label, href }) => ({ label, href })),
};

// TODO(dueño): URLs reales de LinkedIn y X. Sin href no se muestran.
const socialLinks = [
  {
    label: 'LinkedIn',
    href: '',
    icon: 'M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z',
  },
  {
    label: 'X',
    href: '',
    icon: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
  },
  {
    label: 'Instagram',
    href: 'https://www.instagram.com/monkeymind_software/',
    icon: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z',
  },
].filter((social) => social.href);
---

<footer class="border-t border-line px-4 sm:px-6 lg:px-8">
  <div class="container-custom pt-16 pb-10">
    <div class="grid gap-12 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr_1fr]">
      <div>
        <BrandLogo variant="dark" size="sm" />
        <p class="mt-6 max-w-sm text-sm leading-relaxed text-muted">
          Software de agendamiento clínico con IA para IPS, clínicas y centros de diagnóstico en Colombia.
        </p>
        <p class="mt-3 text-sm text-muted">{SITE.email} · Medellín, Colombia</p>
        {socialLinks.length > 0 && (
          <div class="mt-6 flex gap-3">
            {socialLinks.map((social) => (
              <a
                href={social.href}
                class="flex h-11 w-11 items-center justify-center rounded-full border border-line text-muted transition-colors hover:border-accent hover:text-accent"
                aria-label={social.label}
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg class="h-4 w-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d={social.icon} /></svg>
              </a>
            ))}
          </div>
        )}
      </div>

      {Object.entries(footerLinks).map(([title, links]) => (
        <nav aria-label={title}>
          <h3 class="mb-5 text-[11px] font-semibold tracking-[0.18em] text-ink uppercase">{title}</h3>
          <ul class="space-y-3">
            {links.map((link) => (
              <li>
                <a href={link.href} class="relative after:absolute after:inset-x-0 after:-inset-y-3 after:content-[''] text-[13px] text-muted transition-colors hover:text-ink">{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="mt-14 flex flex-col gap-3 border-t border-line pt-6 text-xs sm:flex-row sm:items-center sm:justify-between">
      <p class="text-sm text-muted">Menos llamadas. <span class="font-semibold text-accent">Más citas.</span></p>
      {/* TODO(dueño): confirmar firma de marca única, p. ej. "GEN.AI — software de GEN.AI SAS (Monkey Mind Tech)" */}
      <p class="text-muted">&copy; {currentYear} {SITE.legalName}. Todos los derechos reservados.</p>
    </div>
  </div>
</footer>

<!-- Botón flotante de WhatsApp -->
<a
  id="whatsapp-float"
  href="https://wa.me/573003238106?text=Hola%2C%20me%20interesa%20conocer%20GEN.AI"
  class="fixed right-4 bottom-4 z-50 flex h-14 items-center gap-2.5 rounded-full bg-[#25D366] px-5 text-[15px] font-bold text-white shadow-[0_12px_32px_-10px_rgba(37,211,102,0.7)] transition-transform hover:-translate-y-0.5 sm:right-6 sm:bottom-6"
  aria-label="Contactar por WhatsApp"
  target="_blank"
  rel="noopener noreferrer"
>
  <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.881 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
  </svg>
  <span class="max-sm:hidden">WhatsApp</span>
</a>
