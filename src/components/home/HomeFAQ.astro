---
import { homeFaqs } from '../../data/faqs';

// FAQ a dos columnas de la referencia. Mismo marcado data-faq-* que usa initFAQ.
// El FAQPage del home se genera con estas mismas preguntas (homeFaqs).
---

<section class="section-padding border-t border-line bg-surface" aria-labelledby="faq-title">
  <div class="container-custom grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="eyebrow mb-4">Antes de empezar</p>
      <h2 id="faq-title" class="display-lg text-ink">
        Preguntas <span class="tone">frecuentes.</span>
      </h2>
      <p class="mt-5 max-w-md text-[15px] leading-relaxed text-muted">
        Respuestas directas sobre implementación, instalación e integración con tu historia clínica.
      </p>
      <a href="/faq/" class="mt-6 inline-flex items-center gap-2 text-[13px] font-semibold text-accent hover:underline">
        Ver todas las preguntas
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
    </div>

    <div class="border-t border-line">
      {homeFaqs.map((faq) => (
        <div class="border-b border-line" data-faq-item>
          <button type="button" class="flex w-full items-center justify-between gap-6 py-6 text-left" data-faq-trigger aria-expanded="false">
            <span class="text-[15px] font-semibold tracking-[-0.02em] text-ink">{faq.question}</span>
            <svg class="h-4 w-4 shrink-0 text-accent transition-transform duration-300" data-faq-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
              <path stroke-linecap="round" d="M12 5v14M5 12h14" />
            </svg>
          </button>
          <div class="accordion-content">
            <div class="accordion-inner">
              <p class="pb-6 text-sm leading-relaxed text-muted">{faq.answer}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
