---
// Encabezado de sección de la referencia: rótulo, titular en dos tonos y texto lateral opcional.
interface Props {
  id?: string;
  eyebrow: string;
  title: string;
  tone?: string;
  aside?: string;
  center?: boolean;
  as?: 'h1' | 'h2';
}

const { id, eyebrow, title, tone, aside, center = false, as: Tag = 'h2' } = Astro.props;
---

<header data-animate class:list={['mb-10 gap-8', center ? 'mx-auto max-w-3xl text-center' : 'flex flex-col lg:flex-row lg:items-end lg:justify-between']}>
  <div class:list={[!center && 'max-w-2xl']}>
    <p class="eyebrow mb-4">{eyebrow}</p>
    <Tag id={id} class="display-lg text-ink">
      {title}{tone && ' '}
      {tone && <span class="tone">{tone}</span>}
    </Tag>
  </div>
  {aside && <p class:list={['text-sm leading-relaxed text-muted', center ? 'mt-5' : 'max-w-sm lg:text-right']}>{aside}</p>}
</header>
