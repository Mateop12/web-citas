# Hostinger (LiteSpeed/Apache). Antes de subir: comparar con el .htaccess que ya
# exista en public_html y fusionar; este archivo lo reemplaza.

RewriteEngine On

# www -> apex (hoy www.gena... responde 200 con contenido duplicado)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]

<IfModule mod_headers.c>
  # Sin includeSubDomains/preload hasta confirmar que todos los subdominios sirven HTTPS
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Assets con hash de Astro: inmutables
  <FilesMatch "^.*\.[0-9A-Za-z_-]{8}\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
