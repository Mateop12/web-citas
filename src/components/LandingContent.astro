---
import Heading from './home/Heading.astro';
import Button from './ui/Button.astro';
import { LANDINGS } from '../data/landings';
import type { PageKey } from '../data/pages-seo';

interface Props {
  pageKey: PageKey;
}

const landing = LANDINGS[Astro.props.pageKey]!;
---

<section class="section-padding" aria-labelledby="steps-title">
  <div class="container-custom grid gap-12 lg:grid-cols-[1fr_1.2fr] lg:gap-20">
    <div>
      <p class="eyebrow mb-4">{landing.eyebrow}</p>
      <h2 id="steps-title" class="display-lg text-ink">
        {landing.stepsTitle} <span class="tone">{landing.stepsTone}</span>
      </h2>
    </div>
    <ol class="border-t border-line">
      {landing.steps.map((step, i) => (
        <li class="grid grid-cols-[3rem_1fr] gap-2 border-b border-line py-6">
          <span class="font-mono-data pt-1 text-xs font-semibold text-accent">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <h3 class="text-lg font-semibold tracking-[-0.025em] text-ink">{step.title}</h3>
            <p class="mt-2 text-[15px] leading-relaxed text-muted">{step.text}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<section class="section-padding border-t border-line bg-surface" aria-labelledby="features-title">
  <div class="container-custom">
    <Heading id="features-title" eyebrow="Funciones" title={landing.featuresTitle} tone={landing.featuresTone} />
    <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {landing.features.map((f) => (
        <li class="rounded-xl border border-line bg-card p-6">
          <h3 class="text-lg font-semibold tracking-[-0.025em] text-ink">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section-padding" aria-labelledby="fit-title">
  <div class="container-custom flex flex-col gap-8 rounded-2xl border border-line bg-card px-6 py-10 sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:px-12">
    <div class="max-w-2xl">
      <h2 id="fit-title" class="text-2xl font-bold tracking-[-0.03em] text-ink sm:text-3xl">{landing.fit.title}</h2>
      <p class="mt-4 text-[15px] leading-relaxed text-muted">{landing.fit.text}</p>
    </div>
    <div class="shrink-0">
      <Button openDemoModal variant="primary" size="md">Solicitar demo</Button>
    </div>
  </div>
</section>

<section class="section-padding border-t border-line bg-surface" aria-labelledby="landing-faq-title">
  <div class="container-custom grid gap-12 lg:grid-cols-2 lg:gap-20">
    <div>
      <p class="eyebrow mb-4">Antes de empezar</p>
      <h2 id="landing-faq-title" class="display-lg text-ink">Preguntas <span class="tone">frecuentes.</span></h2>
      <a href="/faq/" class="mt-6 inline-flex items-center gap-2 text-[13px] font-semibold text-accent hover:underline">
        Ver todas las preguntas
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" /></svg>
      </a>
    </div>
    <div class="border-t border-line">
      {landing.faqs.map((faq) => (
        <div class="border-b border-line" data-faq-item>
          <button type="button" class="flex w-full items-center justify-between gap-6 py-6 text-left" data-faq-trigger aria-expanded="false">
            <span class="text-[15px] font-semibold tracking-[-0.02em] text-ink">{faq.q}</span>
            <svg class="h-4 w-4 shrink-0 text-accent transition-transform duration-300" data-faq-icon fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path stroke-linecap="round" d="M12 5v14M5 12h14" /></svg>
          </button>
          <div class="accordion-content">
            <div class="accordion-inner">
              <p class="pb-6 text-sm leading-relaxed text-muted">{faq.a}</p>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
