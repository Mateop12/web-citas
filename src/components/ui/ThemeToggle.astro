---
// Selector sol/luna como en la referencia. El tema inicial lo aplica el script inline de BaseLayout.
---

<button
  type="button"
  data-theme-toggle
  class="theme-toggle relative flex h-11 items-center gap-1 rounded-full border border-line bg-card p-1"
  aria-label="Cambiar entre tema claro y oscuro"
>
  <span class="theme-toggle-knob" aria-hidden="true"></span>
  <span class="relative z-10 flex h-8 w-8 items-center justify-center" data-icon="light" aria-hidden="true">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <circle cx="12" cy="12" r="4" />
      <path stroke-linecap="round" d="M12 2v2m0 16v2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M2 12h2m16 0h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
    </svg>
  </span>
  <span class="relative z-10 flex h-8 w-8 items-center justify-center" data-icon="dark" aria-hidden="true">
    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11Z" />
    </svg>
  </span>
</button>

<style>
  .theme-toggle-knob {
    position: absolute;
    top: 0.25rem;
    left: calc(0.25rem + 2rem + 0.25rem);
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: linear-gradient(115deg, var(--btn-from), var(--btn-to));
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  :global(:root[data-theme='light']) .theme-toggle-knob {
    transform: translateX(calc(-2rem - 0.25rem));
  }

  .theme-toggle [data-icon] {
    color: var(--muted);
  }

  :global(:root:not([data-theme='light'])) .theme-toggle [data-icon='dark'],
  :global(:root[data-theme='light']) .theme-toggle [data-icon='light'] {
    color: var(--btn-text);
  }
</style>
