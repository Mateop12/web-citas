---
interface Props {
  variant?: 'light' | 'dark';
  size?: 'sm' | 'md';
  showName?: boolean;
  showTagline?: boolean;
  stacked?: boolean;
  href?: string;
  class?: string;
}

const {
  variant = 'dark',
  size = 'md',
  showName = true,
  showTagline = false,
  stacked = false,
  href = '/',
  class: className = '',
} = Astro.props;

const iconSize = size === 'sm' ? 'h-11 w-11 rounded-full' : 'h-12 w-12 rounded-full';
const nameSize = size === 'sm' ? 'text-lg' : 'text-2xl';
const nameColor = variant === 'light' ? 'text-white' : 'text-ink';
const linkClass = stacked
  ? `group inline-flex flex-col items-start gap-2 ${className}`
  : `group inline-flex items-center gap-2.5 ${className}`;
---

<div class={stacked ? 'space-y-2' : undefined}>
  <a href={href} class={linkClass}>
    <span class="inline-flex items-center gap-3">
      <img
        src="/logo-96.png"
        alt=""
        class={`${iconSize} object-cover`}
        width={size === 'sm' ? 44 : 48}
        height={size === 'sm' ? 44 : 48}
        loading="eager"
      />
      {
        showName && (
          <span class="flex flex-col leading-none">
            <span class={`font-display ${nameSize} font-bold tracking-[-0.04em] ${nameColor}`}>GEN.AI</span>
            <span class={`mt-1.5 text-[9px] font-semibold tracking-[0.32em] uppercase ${variant === 'light' ? 'text-white/60' : 'text-muted'}`}>
              Agenda clínica
            </span>
          </span>
        )
      }
    </span>
  </a>
  {
    showTagline && (
      <p class={`text-[11px] ${variant === 'light' ? 'text-white/50' : 'text-muted'}`}>Agendamiento clínico con IA</p>
    )
  }
</div>
