---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import PageBreadcrumb from '../../components/ui/PageBreadcrumb.astro';
import Button from '../../components/ui/Button.astro';
import { SITE, buildBreadcrumbSchema, buildCanonicalUrl } from '../../data/seo';

const posts = (await getCollection('blog')).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const siteBase = Astro.site?.href ?? SITE.url;
const breadcrumbSchema = buildBreadcrumbSchema([
  { name: 'Inicio', url: buildCanonicalUrl('/', siteBase) },
  { name: 'Blog', url: buildCanonicalUrl('/blog/', siteBase) },
]);
const formatDate = (d: Date) =>
  d.toLocaleDateString('es-CO', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---

<BaseLayout
  title={`Blog de agendamiento médico para IPS | ${SITE.name}`}
  description="Guías sobre agendamiento médico en Colombia: oportunidad de citas, inasistencia, demanda inducida y software para IPS y clínicas, con fuentes oficiales."
  extraStructuredData={[breadcrumbSchema]}
>
  <Navbar />
  <main id="main-content">
    <header class="section-band border-b border-line/60 px-4 pt-32 pb-12 sm:px-6 lg:px-8 lg:pt-40 lg:pb-16">
      <div class="container-custom">
        <PageBreadcrumb items={[{ label: 'Inicio', href: '/' }, { label: 'Blog' }]} />
        <h1 class="display-lg max-w-4xl text-ink">Blog de agendamiento médico para IPS y clínicas</h1>
        <p class="mt-5 max-w-2xl text-base leading-relaxed text-muted sm:text-lg">
          Normativa, indicadores y buenas prácticas para la gestión de citas en el sistema de salud colombiano.
          Cada guía cita la norma o el estudio del que sale, para que tu equipo pueda verificarla antes de decidir.
        </p>
      </div>
    </header>

    <section class="section-padding" aria-label="Artículos">
      <ul class="container-custom grid gap-5 md:grid-cols-2">
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}/`} class="group flex h-full flex-col rounded-2xl border border-line bg-card p-6 transition-colors hover:border-primary/30 lg:p-8">
              <time datetime={post.data.pubDate.toISOString().slice(0, 10)} class="text-xs text-muted">{formatDate(post.data.pubDate)}</time>
              <h2 class="mt-3 text-xl font-semibold tracking-[-0.025em] text-ink group-hover:text-primary">{post.data.h1}</h2>
              <p class="mt-3 text-sm leading-relaxed text-muted">{post.data.description}</p>
              <span class="mt-auto pt-5 text-[13px] font-medium text-accent">Leer guía →</span>
            </a>
          </li>
        ))}
      </ul>
      <div class="container-custom mt-12 flex flex-col items-start gap-4 rounded-2xl border border-line bg-card p-6 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-[15px] text-ink">¿Prefieres verlo funcionando? Te mostramos GENACITAS con la agenda de tu institución.</p>
        <Button openDemoModal variant="primary" size="md">Solicitar demo</Button>
      </div>
    </section>
  </main>
  <Footer />
</BaseLayout>
